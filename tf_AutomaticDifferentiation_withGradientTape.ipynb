   "metadata": {},
   "outputs": [],
   "source": [
    "import tensorflow as tf"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "0f2e5a5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = tf.Variable(3.0)\n",
    "z = tf.Variable(2.0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "3bd5fc74",
   "metadata": {},
   "outputs": [],
   "source": [
    "with tf.GradientTape() as tape:\n",
    "    f =x * z+z ** 2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "c6850848",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "dy/dx: 2.0\n",
      "dy/dz: 7.0\n"
     ]
    }
   ],
   "source": [
    "grads = tape.gradient(f, [x, z])\n",
    "print(\"dy/dx:\",grads[0].numpy())\n",
    "print(\"dy/dz:\",grads[1].numpy())"
   ]
  }
 ],
